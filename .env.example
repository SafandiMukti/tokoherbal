# Salin file ini menjadi .env lalu isi nilainya. File .env JANGAN di-commit.
#
# DB_PASSWORD: pakai huruf dan angka saja (karakter seperti @ : / # merusak
# DATABASE_URL yang disusun di docker-compose.yml).
DB_PASSWORD=ganti-ini-dengan-huruf-dan-angka

# JWT_SECRET: minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Alamat web Next.js yang boleh memanggil API dari browser (CORS).
CORS_ORIGIN=http://localhost:3000

# INTERNAL_TOKEN: rahasia bersama antara web dan product-service, minimal 16 karakter.
# Panggilan server-ke-server yang membawanya tidak kena rate limit per-IP. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# WAJIB diisi: docker compose menolak berjalan bila kosong.
INTERNAL_TOKEN=ganti-dengan-string-acak-minimal-16-karakter
