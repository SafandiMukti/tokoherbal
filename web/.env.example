# --- Dipakai SERVER Next.js (di Docker: nama service, bukan localhost) ---
PRODUCT_API_URL=http://localhost:8082
AUTH_API_URL=http://localhost:8081
# --- Alamat product-service yang dibuka BROWSER (hanya untuk gambar produk) ---
PUBLIC_PRODUCT_URL=http://localhost:8082
# Rahasia bersama dengan product-service (minimal 16 karakter). Panggilan server-ke-server
# yang membawanya tidak kena rate limit per-IP. Harus SAMA dengan INTERNAL_TOKEN di product-service.
# Kosongkan bila tidak dipakai.
INTERNAL_TOKEN=
# Isi true bila situs dilayani lewat HTTPS (cookie hanya dikirim lewat HTTPS)
COOKIE_SECURE=false
